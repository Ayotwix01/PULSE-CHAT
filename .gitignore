cat > .gitignore <<'EOF'
# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Django local database
db.sqlite3
*.sqlite3

# Node
node_modules/
dist/
dist-ssr/

# Logs
*.log

# OS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Local files
*.local
EOF